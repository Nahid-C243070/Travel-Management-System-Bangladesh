meta {
  name: Register User
  type: http
  seq: 1
}

post {
  url: {{baseUrl}}/api/auth/register
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "fullName": "Zubayer Isfar",
    "email": "isfarjubayer@gmail.com",
    "password": "isfarjubayer@gmail.com"
  }
}

script:post-response {
  const json = res.body;
  if (json && json.data) {
    bru.setVar("accessToken", json.data.accessToken);
    bru.setVar("refreshToken", json.data.refreshToken);
    bru.setVar("userId", json.data.user.id);
    try {
      bru.setEnvVar("accessToken", json.data.accessToken, { persist: true });
      bru.setEnvVar("refreshToken", json.data.refreshToken, { persist: true });
      bru.setEnvVar("userId", json.data.user.id, { persist: true });
    } catch (e) {}
  }
}

tests {
  test("Status code is successful", function () {
    expect(res.status).to.be.oneOf([200, 201]);
  });
  
  test("Response has success=true", function () {
    expect(res.body.success).to.equal(true);
  });
}
