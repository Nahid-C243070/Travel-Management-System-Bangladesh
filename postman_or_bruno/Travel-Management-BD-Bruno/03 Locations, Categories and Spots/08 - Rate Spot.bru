meta {
  name: Rate Spot
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/api/spots/{{spotId}}/ratings
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "rating": 5,
    "review": "Excellent destination and route experience."
  }
}

tests {
  test("Status code is successful", function () {
    expect(res.status).to.be.oneOf([200, 201]);
  });

  test("Response has success=true", function () {
    expect(res.body.success).to.equal(true);
  });
}
