meta {
  name: Generate Alternative Routes
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/api/routes/alternatives
  body: json
  auth: none
}

headers {
  Content-Type: application/json
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "startLat": 23.8103,
    "startLng": 90.4125,
    "districtId": "{{dhakaDistrictId}}",
    "passengers": 4
  }
}

tests {
  test("Status code is successful", function () {
    expect(res.status).to.be.oneOf([200, 201]);
  });

  test("Response has success=true", function () {
    expect(res.body.success).to.equal(true);
  });
}
